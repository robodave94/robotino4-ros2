<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rto4_bringup</name>
  <version>0.0.0</version>
  <description>Bringup launch files for Festo Robotino4</description>
  <maintainer email="karahul209@gmail.com">rahul</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>rto4_node</exec_depend>
  <exec_depend>rto4_description</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <!-- Visualisation-only: dropped on a headless Pi build (PI_BUILD=1). -->
  <exec_depend condition="$PI_BUILD != 1">joint_state_publisher_gui</exec_depend>
  <exec_depend condition="$PI_BUILD != 1">rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>teleop_twist_keyboard</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>